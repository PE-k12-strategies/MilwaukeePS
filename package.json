{
  "name": "mps-lrfmp-strategy-tool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite app.html --host",
    "build": "tsc -b && vite build",
    "build:watch": "vite build --watch",
    "golive": "concurrently -k -n build,serve -c blue,green \"vite build --watch\" \"live-server . --port=5500 --open=/index.html --watch=bundle --ignorePattern=node_modules --ignorePattern=src --no-css-inject\"",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "html2canvas-pro": "^2.3.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "live-server": "^1.2.2",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
